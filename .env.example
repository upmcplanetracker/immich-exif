# Immich connection
IMMICH_URL=http://immich-server:2283

# One or more API keys. Comma-separated, single line.
# Rotated automatically on 401/403/429. No spaces required.
IMMICH_API_KEYS=YOUR_API_KEY_HERE

# Sync scheduling (seconds)
SYNC_INTERVAL=900

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/exif-writer.log

# Sync state
STATE_FILE=/app/state/sync_state.json

# Safety toggles for EXIF writes.
# Dry run logs intended writes and modifies nothing — use it first.
# EXIF_DRY_RUN=1
# Keep backups so ExifTool saves <file>_original before editing.
# Default is 1 (on). Set to 0 only after you trust the tool.
# EXIF_KEEP_BACKUPS=0
